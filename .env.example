# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Postgres connection string from your Supabase project.
# Get it from: Supabase Project -> Connect (top of page) -> "Transaction pooler"
# tab -> copy the URI, then replace [YOUR-PASSWORD] with your database password.
# Using the pooler (not the direct connection) matters — it's what lets this
# app scale on Vercel's serverless functions.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Base URL of the deployed site (used in emails, invite links, QR codes).
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app (or your custom domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: enables real email sending (registration receipts, approval
# notices, collaborator invites). Without it, the app still works —
# emails are just skipped and logged instead of sent.
# Get a free key at https://resend.com
RESEND_API_KEY=""
